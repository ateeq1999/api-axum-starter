# Copy to `.env` and fill in the blanks. Real environment variables override this file.
#
# Every variable is active. A BLANK value means "not set" and behaves exactly like a missing
# line: the built-in default applies, or the optional feature stays off. Only three need a value
# to start: DATABASE_URL, JWT_SECRET (blank fails at startup) and, in production, FRONTEND_URL.

# --- Core ---------------------------------------------------------------------------------------
# A Postgres database (the app runs its own migrations at startup). Create the database first,
# e.g. `createdb api_starter_db` or `psql -c 'CREATE DATABASE api_starter_db'`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/api_starter_db
# Postgres connection pool size. Tune alongside instance count and Postgres's own max_connections.
DATABASE_MAX_CONNECTIONS=10
# 127.0.0.1 is only reachable from the machine itself. Use 0.0.0.0:3000 inside Docker.
BIND_ADDR=127.0.0.1:3000
# Comma-separated browser origins allowed to call this API cross-origin, e.g.
# https://app.example.com,https://staging.example.com. Blank = just FRONTEND_URL.
# `*` allows any origin (dev convenience only).
CORS_ALLOWED_ORIGINS=
# Largest request body accepted anywhere in the API (bytes), enforced before a handler runs.
MAX_REQUEST_BODY_BYTES=10485760
# REQUIRED, at least 32 characters. Generate one with:  cargo run -- gen --secrets
# (or:  openssl rand -hex 32). `cargo run -- setup` fills it in for you on a fresh checkout.
JWT_SECRET=
JWT_TTL_SECS=3600
# `json` for structured logs (production), `text` for human-readable.
LOG_FORMAT=text
RUST_LOG=api_starter_axum=debug,tower_http=debug,sqlx=warn,info

# --- Mail ---------------------------------------------------------------------------------------
# false => emails are only logged (dev). true => send through the SMTP server below.
MAIL_ENABLED=false
# Local Mailpit (docker compose -f docker-compose.dev.yml up -d): SMTP_HOST=127.0.0.1,
# SMTP_PORT=1025, SMTP_TLS=none. Its web UI is http://localhost:8025 (HTTP, not SMTP: never point
# SMTP_PORT at it). A real server usually needs SMTP_PORT=587 + SMTP_TLS=starttls (or 465 + tls)
# and credentials. Use the Docker service name for SMTP_HOST if the API shares its network.
# SMTP_HOST and MAIL_FROM are required once MAIL_ENABLED=true.
SMTP_HOST=
SMTP_PORT=587
# none | starttls | tls
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. "Acme <no-reply@example.com>"
MAIL_FROM=

# --- Links inside emails / account flows --------------------------------------------------------
# Where your frontend lives. Emailed links point here, and it is the default CORS/passkey origin.
# Set this to your real URL in production.
FRONTEND_URL=http://localhost:3001
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_CHANGE_TTL_MINUTES=60
REQUIRE_VERIFIED_EMAIL=false
# Per client IP, for login / register / password reset / email verification endpoints.
RATE_LIMIT_PER_MINUTE=20
# Trust X-Forwarded-For (its right-most entry) for the client IP. Only set true behind exactly
# one trusted reverse proxy that sets/appends that header itself.
TRUST_PROXY_HEADERS=false
# Also reject passwords found in the Have I Been Pwned breach database (only a 5-character hash
# prefix is ever sent). Off by default: an outage of that external service must never block
# registration or login.
CHECK_PASSWORD_BREACHES=false
# Per-account brute-force protection (independent of RATE_LIMIT_PER_MINUTE, which is per-IP).
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- First administrator (created at startup only if no admin exists) ---------------------------
# Set BOTH or neither. Blank = no administrator is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Password hashing ---------------------------------------------------------------------------
# Max simultaneous argon2 operations. Each one allocates ~19 MiB, so peak memory is roughly
# this number x 19 MiB, however much login/register traffic arrives.
MAX_CONCURRENT_HASHES=8

# --- File storage: profile photos and media uploads ---------------------------------------------
# Local-disk root for every upload, created at startup. Mount a volume here in Docker.
# Ignored when S3_BUCKET is set.
UPLOAD_DIR=./uploads
# Set S3_BUCKET to store uploads in S3 instead of local disk (keys: avatars/..., media/...).
# The bucket must already exist; the app checks it at startup and refuses to start if it cannot
# reach it. Blank = local disk.
S3_BUCKET=
# Blank = automatic: on when AWS_ENDPOINT_URL is set (local emulators need it), off for real AWS.
S3_FORCE_PATH_STYLE=
# Standard AWS settings. On EC2 leave the key pair and endpoint blank: the instance role is used.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for a local S3 emulator (floci, LocalStack, MinIO), e.g. http://localhost:4566 together
# with AWS_ACCESS_KEY_ID=test and AWS_SECRET_ACCESS_KEY=test. Blank = real AWS.
AWS_ENDPOINT_URL=
# User media uploads (POST /api/v1/media). The type is detected from the file's bytes, not the
# client's Content-Type. MEDIA_MAX_UPLOAD_BYTES must not exceed MAX_REQUEST_BODY_BYTES.
MEDIA_MAX_UPLOAD_BYTES=8388608
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,video/mp4,video/webm,audio/mpeg,audio/ogg

# --- OAuth sign-in (a provider is enabled when both its id and secret are set) ------------------
# Public base URL of THIS API. The redirect URI you register at Google/GitHub is
#   {PUBLIC_API_URL}/api/v1/auth/oauth/<google|github>/callback
# Blank = http://localhost:<port of BIND_ADDR>. Must match the registered URI exactly.
PUBLIC_API_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Passkeys (WebAuthn) ------------------------------------------------------------------------
# Blank RP id / origin are derived from FRONTEND_URL (rp id = its host, origin = its
# scheme://host:port). Changing the RP id later invalidates every registered passkey.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=api-starter-axum
WEBAUTHN_ORIGIN=

# --- QR-code sign-in ----------------------------------------------------------------------------
# How long a QR code is valid, and the per-IP limit for polling it (per minute).
QR_LOGIN_TTL_SECS=120
QR_POLL_RATE_LIMIT_PER_MINUTE=120

# --- Metrics (Prometheus) -----------------------------------------------------------------------
# /metrics is served on its own listener, outside the app's router and CORS/compression stack.
# Loopback-only by default (secure). A Dockerized Prometheus (docker-compose.monitoring.yml)
# cannot reach 127.0.0.1, so local scraping needs 0.0.0.0:9091 here.
METRICS_BIND_ADDR=127.0.0.1:9091
# Optional: require `Authorization: Bearer <token>` to read /metrics. Generate one with
# `cargo run -- gen --secrets` (it also updates monitoring/prometheus.yml).
METRICS_TOKEN=
