# Copy to `.env` and adjust. Real environment variables override this file.
# A Postgres database (the app runs its own migrations at startup). Create the database first,
# e.g. `createdb api_starter_db` or `psql -c 'CREATE DATABASE api_starter_db'`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/api_starter_db
BIND_ADDR=127.0.0.1:3000
# Generate one with:  cargo run -- gen --secrets  (or:  openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SECS=3600
# Optional. `json` for structured logs (production), anything else for human-readable.
# LOG_FORMAT=json
# RUST_LOG=axum_starter=debug,tower_http=debug,info
# --- Mail -----------------------------------------------------------------------------------
# false => emails are only logged (dev). true => send through the SMTP server below.
MAIL_ENABLED=false
# Local Mailpit (docker compose -f docker-compose.dev.yml up -d): SMTP is port 1025, plain text.
# Its web UI is http://localhost:8025 (HTTP, not SMTP: never point SMTP_PORT at it).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_TLS=none
# A real server usually needs: SMTP_PORT=587, SMTP_TLS=starttls (or 465 with tls), credentials.
# Use the Docker service name for SMTP_HOST if the API shares the mail server's network.
# SMTP_USERNAME=api@example.com
# SMTP_PASSWORD=change-me
# MAIL_FROM="Acme <no-reply@example.com>"

# --- Links inside emails / account flows ------------------------------------------------------
FRONTEND_URL=http://localhost:3001
# PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_VERIFICATION_TTL_HOURS=24
# EMAIL_CHANGE_TTL_MINUTES=60
# REQUIRE_VERIFIED_EMAIL=false
# Per client IP, for login / register / password reset / email verification endpoints.
# RATE_LIMIT_PER_MINUTE=20
# Trust X-Forwarded-For (its right-most entry) for the client IP. Only set this behind exactly
# one trusted reverse proxy that sets/appends that header itself.
# TRUST_PROXY_HEADERS=false

# --- First administrator (created at startup only if no admin exists) -------------------------
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please

# --- Password hashing ---------------------------------------------------------------------------
# Max simultaneous argon2 operations. Each one allocates ~19 MiB, so peak memory is roughly
# this number x 19 MiB, however much login/register traffic arrives.
# MAX_CONCURRENT_HASHES=8

# --- Profile photos -----------------------------------------------------------------------------
# Where uploaded avatars are stored (created at startup). Mount a volume here in Docker.
# UPLOAD_DIR=./uploads

# --- OAuth sign-in (optional; a provider is enabled when both its id and secret are set) --------
# Public base URL of THIS API. The redirect URI you register at Google/GitHub is
#   {PUBLIC_API_URL}/api/v1/auth/oauth/<google|github>/callback
# Defaults to http://localhost:<port of BIND_ADDR>. Must match the registered URI exactly.
# PUBLIC_API_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Passkeys (WebAuthn) ------------------------------------------------------------------------
# Derived from FRONTEND_URL by default (rp id = its host, origin = its scheme://host:port).
# Changing the RP id later invalidates every registered passkey.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=api-starter-axum
# WEBAUTHN_ORIGIN=http://localhost:5173

# --- QR-code sign-in ----------------------------------------------------------------------------
# How long a QR code is valid, and the per-IP limit for polling it (per minute).
# QR_LOGIN_TTL_SECS=120
# QR_POLL_RATE_LIMIT_PER_MINUTE=120

# --- Metrics (Prometheus) ------------------------------------------------------------------------
# /metrics is served on its own listener, outside the app's router and CORS/compression stack.
# Defaults to loopback-only (secure). A Dockerized Prometheus (docker-compose.monitoring.yml)
# cannot reach 127.0.0.1 via host.docker.internal, so local scraping needs:
# METRICS_BIND_ADDR=0.0.0.0:9091
# Optional: require `Authorization: Bearer <token>` to read /metrics.
# Generate one with `cargo run -- gen --secrets` (it also updates monitoring/prometheus.yml).
# METRICS_TOKEN=
